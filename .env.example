# Shift4 Partner UK Environment Variables

# Site Domain URL
NEXT_PUBLIC_SITE_URL=https://www.shift4partner.co.uk

# Lead Pipeline & Email Notification (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
LEAD_NOTIFICATION_EMAIL=quotes@shift4partner.co.uk

# CRM Webhook (Google Sheets, Zapier, Make, HubSpot, or Salesforce)
CRM_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your_webhook_id/

# Google Analytics 4 & Google Tag Manager
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Meta Pixel (Facebook & Instagram Ads)
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# Anti-Spam (Cloudflare Turnstile or reCAPTCHA v3)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAXXXXXXXXXXXXX
TURNSTILE_SECRET_KEY=0x4AAAAAAXXXXXXXXXXXXX
